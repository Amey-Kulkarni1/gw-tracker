{
  "manifest_version": 3,
  "name": "GW Tracker",
  "version": "1.1",
  "description": "Combines tab saving, Twitter tools, and Gleam helper.",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GW Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.gleam.io/*",
        "*://*.sweepwidget.com/*",
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "skinsData.js",
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "save-for-later-auto-detect": {
      "description": "Save for Later (Auto-detect)"
    }
  }
}